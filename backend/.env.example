# NetScope IPv6 Auditor Environment Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/netscope_ipv6_auditor
NODE_ENV=development

# Measurement Configuration
DEFAULT_TIMEOUT_MS=10000
MAX_DISCOVERY_DURATION_MS=25000
MAX_CONCURRENT_MEASUREMENTS=5
BROWSER_HEADLESS=true

# Security Settings
ALLOW_PRIVATE_IPS_FOR_LAB=false
LAB_PORT=5005
